# ============================================
# Web3Geeks Support Triage Agent
# Environment Configuration
# ============================================

# Company OpenAI-compatible LLM endpoint
LLM_BASE_URL=https://llm.netixsol.com/v1

# API key (obtain from your administrator)
API_KEY=your_api_key_here

# Model fallback chain (in order of preference)
PRIMARY_MODEL=smart
FALLBACK_MODEL_1=smart-lite
FALLBACK_MODEL_2=fast

# Request timeout (seconds)
LLM_TIMEOUT_SECONDS=20

# LLM execution mode
# live = call the real company endpoint
# mock = use deterministic offline responses for local development/evaluation
LLM_MODE=live

# Directory for application logs
LOG_DIR=logs
