{
  "name": "Real Estate Voice Agent - Appointment Workflow",
  "nodes": [
    {
      "id": "n1-incoming-call",
      "name": "Incoming Call",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "real-estate-incoming-call",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "n2-config",
      "name": "Set Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300],
      "notes": "Set FASTAPI_BASE_URL here once (e.g. http://localhost:8000) instead of hardcoding it into every HTTP Request node below.",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "base-url",
              "name": "fastapi_base_url",
              "type": "string",
              "value": "http://localhost:8000"
            },
            {
              "id": "session-id",
              "name": "session_id",
              "type": "string",
              "value": "={{ $json.body.call_id || $json.body.session_id }}"
            },
            {
              "id": "transcript",
              "name": "transcript",
              "type": "string",
              "value": "={{ $json.body.transcript }}"
            },
            {
              "id": "phone",
              "name": "phone",
              "type": "string",
              "value": "={{ $json.body.phone }}"
            },
            {
              "id": "client-name",
              "name": "client_name",
              "type": "string",
              "value": "={{ $json.body.client_name }}"
            }
          ]
        }
      }
    },
    {
      "id": "n3-intent-detection",
      "name": "Intent Detection",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300],
      "notes": "Lightweight keyword-based booking-intent classifier on the caller's transcript. Kept simple deliberately -- the real conversational understanding already happens inside app/graph/agent_graph.py's slot extraction; this only decides whether to route the call toward the booking sub-flow.",
      "parameters": {
        "jsCode": "const transcript = ($json.transcript || '').toLowerCase();\nconst bookingKeywords = ['appointment', 'visit', 'meeting', 'schedule', 'milna', 'dekhna hai', 'dikhado', 'book kar', 'time de'];\nconst hasBookingIntent = bookingKeywords.some(k => transcript.includes(k));\nreturn [{ json: { ...$json, has_booking_intent: hasBookingIntent } }];"
      }
    },
    {
      "id": "n4-if-booking",
      "name": "Has Booking Intent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-booking",
              "leftValue": "={{ $json.has_booking_intent }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "n5-property-match",
      "name": "Property Match",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 180],
      "notes": "Thin wrapper over the EXISTING app/recommendation/recommender.py PropertyRecommender -- see POST /properties/match in app/api/routes.py. Does not reimplement matching logic.",
      "parameters": {
        "method": "POST",
        "url": "={{ $json.fastapi_base_url }}/properties/match",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session_id\": $json.session_id, \"message\": $json.transcript } }}",
        "options": { "timeout": 8000 }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
      "onError": "continueErrorOutput"
    },
    {
      "id": "n5b-merge-booking-fields",
      "name": "Merge Booking Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [990, 180],
      "notes": "Recombines Property Match's response with the original call context (Set Config), which the HTTP Request node otherwise discards -- n8n's HTTP Request node output is the raw response body only, it does not merge with the input item. References Set Config by name via $('Set Config') rather than relying on data passthrough. Property Match's own output fields are read via plain $json since this node runs immediately after it. Field names here match exactly what Appointment's request body already expects, so Appointment itself needs no changes.",
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "f-base-url", "name": "fastapi_base_url", "type": "string", "value": "={{ $('Set Config').item.json.fastapi_base_url }}" },
            { "id": "f-session-id", "name": "session_id", "type": "string", "value": "={{ $('Set Config').item.json.session_id }}" },
            { "id": "f-client-name", "name": "client_name", "type": "string", "value": "={{ $('Set Config').item.json.client_name }}" },
            { "id": "f-phone", "name": "phone", "type": "string", "value": "={{ $('Set Config').item.json.phone }}" },
            { "id": "f-transcript", "name": "transcript", "type": "string", "value": "={{ $('Set Config').item.json.transcript }}" },
            { "id": "f-matched", "name": "matched", "type": "boolean", "value": "={{ $json.matched }}" },
            { "id": "f-matched-name", "name": "matched_property_name", "type": "string", "value": "={{ $json.matched_property_name }}" },
            { "id": "f-budget", "name": "budget", "type": "string", "value": "={{ $json.budget }}" },
            { "id": "f-location", "name": "preferred_location", "type": "string", "value": "={{ $json.preferred_location }}" },
            { "id": "f-prop-type", "name": "property_type", "type": "string", "value": "={{ $json.property_type }}" },
            { "id": "f-requirements", "name": "requirements", "type": "string", "value": "={{ $json.requirements }}" }
          ]
        }
      }
    },
    {
      "id": "n6-appointment",
      "name": "Appointment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 180],
      "notes": "Calls POST /appointments/book, which internally runs app/workflows/appointment_manager.py:book_appointment() -- Calendar event creation, employee email, and CRM logging are all performed atomically inside that single call. The three downstream 'Google Calendar' / 'Email' / 'CRM Update' nodes read the structured result of THIS call rather than performing separate independent actions, so a partial failure can't leave Calendar/CRM/email out of sync with each other. NOTE: date/requested_time are not currently produced anywhere upstream (no date/time extraction exists in slot_extractor.py or ConversationState) -- these will arrive null until that gap is addressed as its own issue.",
      "parameters": {
        "method": "POST",
        "url": "={{ $json.fastapi_base_url }}/appointments/book",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"client_name\": $json.client_name,\n  \"phone\": $json.phone,\n  \"property_name\": $json.matched_property_name,\n  \"date\": $json.requested_date,\n  \"time_str\": $json.requested_time,\n  \"budget\": $json.budget,\n  \"preferred_location\": $json.preferred_location,\n  \"property_type\": $json.property_type,\n  \"requirements\": $json.requirements,\n  \"transcript\": $json.transcript\n} }}",
        "options": { "timeout": 15000 }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "n7-calendar-status",
      "name": "Google Calendar",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1320, 80],
      "notes": "Reporting/branching node -- the actual Calendar event was already created inside the Appointment call above (app/calendar/google_calendar.py:create_event). This node just surfaces calendar_event_id for downstream visibility/logging.",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cal-event-id",
              "name": "calendar_event_id",
              "type": "string",
              "value": "={{ $json.appointment.calendar_event_id }}"
            }
          ]
        }
      }
    },
    {
      "id": "n8-email-status",
      "name": "Email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1320, 180],
      "notes": "Reporting node -- the employee notification email was already sent inside the Appointment call (app/email/email_service.py:send_appointment_notification).",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assigned-employee",
              "name": "assigned_employee",
              "type": "string",
              "value": "={{ $json.appointment.assigned_employee }}"
            }
          ]
        }
      }
    },
    {
      "id": "n9-crm-status",
      "name": "CRM Update",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1320, 280],
      "notes": "Reporting node -- CRM client + appointment rows were already written inside the Appointment call (app/crm/crm_service.py:upsert_client / add_appointment).",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "appointment-id",
              "name": "appointment_id",
              "type": "string",
              "value": "={{ $json.appointment.appointment_id }}"
            },
            {
              "id": "appointment-status",
              "name": "appointment_status",
              "type": "string",
              "value": "={{ $json.appointment.status }}"
            }
          ]
        }
      }
    },
    {
      "id": "n10-success",
      "name": "Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1540, 180],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"success\", \"appointment_id\": $json.appointment_id, \"calendar_event_id\": $json.calendar_event_id, \"assigned_employee\": $json.assigned_employee } }}"
      }
    },
    {
      "id": "n11-no-booking-chat",
      "name": "General Conversation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 420],
      "notes": "Non-booking calls are routed to the existing conversational agent (POST /chat -> app/graph/agent_graph.py:handle_turn) instead of the appointment sub-flow.",
      "parameters": {
        "method": "POST",
        "url": "={{ $json.fastapi_base_url }}/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"session_id\": $json.session_id, \"message\": $json.transcript } }}",
        "options": { "timeout": 8000 }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "n12-success-chat",
      "name": "Success (Conversation)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1100, 420],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"success\", \"response\": $json.response } }}"
      }
    },
    {
      "id": "n13-error-handler",
      "name": "Booking Failed - Notify",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1100, 620],
      "notes": "Catches error-output branches from Property Match, Appointment, and General Conversation (all set to onError: continueErrorOutput above). Returns a clear error rather than letting the webhook caller hang or get a raw 5xx.",
      "parameters": {
        "respondWith": "json",
        "responseCode": 502,
        "responseBody": "={{ { \"status\": \"error\", \"message\": \"Appointment workflow failed, please retry or contact support.\", \"detail\": $json.error?.message || 'Unknown error' } }}"
      }
    }
  ],
  "connections": {
    "Incoming Call": {
      "main": [[{ "node": "Set Config", "type": "main", "index": 0 }]]
    },
    "Set Config": {
      "main": [[{ "node": "Intent Detection", "type": "main", "index": 0 }]]
    },
    "Intent Detection": {
      "main": [[{ "node": "Has Booking Intent?", "type": "main", "index": 0 }]]
    },
    "Has Booking Intent?": {
      "main": [
        [{ "node": "Property Match", "type": "main", "index": 0 }],
        [{ "node": "General Conversation", "type": "main", "index": 0 }]
      ]
    },
    "Property Match": {
      "main": [
        [{ "node": "Merge Booking Fields", "type": "main", "index": 0 }],
        [{ "node": "Booking Failed - Notify", "type": "main", "index": 0 }]
      ]
    },
    "Merge Booking Fields": {
      "main": [[{ "node": "Appointment", "type": "main", "index": 0 }]]
    },
    "Appointment": {
      "main": [
        [
          { "node": "Google Calendar", "type": "main", "index": 0 },
          { "node": "Email", "type": "main", "index": 0 },
          { "node": "CRM Update", "type": "main", "index": 0 }
        ],
        [{ "node": "Booking Failed - Notify", "type": "main", "index": 0 }]
      ]
    },
    "Google Calendar": {
      "main": [[{ "node": "Success", "type": "main", "index": 0 }]]
    },
    "Email": {
      "main": [[{ "node": "Success", "type": "main", "index": 0 }]]
    },
    "CRM Update": {
      "main": [[{ "node": "Success", "type": "main", "index": 0 }]]
    },
    "General Conversation": {
      "main": [
        [{ "node": "Success (Conversation)", "type": "main", "index": 0 }],
        [{ "node": "Booking Failed - Notify", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "versionId": "2",
  "id": "real-estate-appointment-workflow",
  "tags": ["real-estate", "voice-agent", "day4"]
}