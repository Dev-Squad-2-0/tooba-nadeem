# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# --- LLM (via OpenRouter — OpenAI-compatible API) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Speech-to-Text (Deepgram) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ur

# --- Text-to-Speech (Edge TTS) ---
EDGE_TTS_VOICE=ur-PK-AsadNeural
EDGE_TTS_RATE=+0%

# --- Google Calendar ---
# credentials.json and token.json are mounted as separate files (see README),
# not set here. GOOGLE_CALENDAR_ID and CALENDAR_TIMEZONE below have working
# defaults in app/config.py, so these are only needed to override them.
GOOGLE_CALENDAR_ID=primary
CALENDAR_TIMEZONE=Asia/Karachi

# --- SMTP Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Session ---
# Optional — defaults to 1800 (30 min) in app/config.py.
# SESSION_TTL_SECONDS=1800
